{
  "name": "swift-sweeps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "start": "vite preview --port 3000 --host 0.0.0.0",
    "start:api": "node dist-server/index.js",
    "lint": "tsc --noEmit && npm run lint:server",
    "lint:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "tsx --test server/tests/*.test.ts",
    "db:migrate:check": "tsx server/db/migrate.ts check",
    "db:migrate:status": "tsx server/db/migrate.ts status",
    "db:migrate:up": "tsx server/db/migrate.ts up",
    "db:data:preflight": "tsx server/db/dataMigration.ts preflight",
    "db:data:export": "tsx server/db/dataMigration.ts export",
    "db:data:import": "tsx server/db/dataMigration.ts import",
    "db:data:validate": "tsx server/db/dataMigration.ts validate",
    "auth:migrate:status": "tsx server/db/authMigrate.ts status",
    "auth:migrate:sql": "tsx server/db/authMigrate.ts sql",
    "auth:migrate:up": "tsx server/db/authMigrate.ts up"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.28",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
