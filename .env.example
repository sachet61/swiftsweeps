# ==============================================================================
# SwiftSweeps Environment Variables Template
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit `.env` or real secrets, passwords, private keys, or tokens.
# - On a VPS, store runtime secrets outside the repository at:
#     /etc/swiftsweeps/api.env (chmod 0640, owner root:swiftsweeps)
# - NEVER put private credentials into VITE_* variables (VITE_* values are
#   bundled into client JavaScript served to browsers).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node API Listener, Origins & Proxy Trust (Required for API Runtime)
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=production

# Bind strictly to loopback when Nginx runs on the same host (NEVER 0.0.0.0 publicly)
HOST=127.0.0.1
API_PORT=4000

# Canonical HTTPS origin (required in production; no trailing slash or wildcard)
APP_ORIGIN=https://__YOUR_DOMAIN__

# Optional comma-separated extra trusted origins (must be exact scheme + host)
TRUSTED_ORIGINS=

# Reverse proxy trust setting for Express: loopback | false | <1..5>
TRUST_PROXY=loopback

# Default JSON body limit (upload routes enforce tighter 3mb/4mb limits in server/app.ts)
REQUEST_BODY_LIMIT=1mb

# Options: debug | info | warn | error
LOG_LEVEL=info

# Graceful shutdown drain timeout in milliseconds (1000..60000)
SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection & Pool Tuning (Required for API Runtime)
# ------------------------------------------------------------------------------
# Use the least-privilege runtime role (`swiftsweeps_app`), NOT postgres superuser.
# Use `swiftsweeps_migrator` separately only during schema migrations.
DATABASE_URL=postgres://swiftsweeps_app:__CHANGE_ME_APP_DB_PASSWORD__@127.0.0.1:5432/swiftsweeps

# Options: disable (local loopback) | require | verify-full (remote private PG with TLS)
PG_SSL_MODE=disable
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. Better Auth Session & Rate Limiting (Required for API Runtime)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (minimum 32 chars; required in production)
AUTH_SECRET=__REPLACE_WITH_64_CHAR_HEX_AUTH_SECRET__
AUTH_COOKIE_PREFIX=swiftsweeps_auth
AUTH_SESSION_EXPIRES_IN_SEC=604800
AUTH_SESSION_UPDATE_AGE_SEC=86400
AUTH_SESSION_FRESH_AGE_SEC=900
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# 4. Transactional Email Delivery (OTP Verification & Password Resets)
# ------------------------------------------------------------------------------
# Options: disabled | brevo | smtp
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@__YOUR_DOMAIN__
EMAIL_FROM_NAME=SwiftSweeps

# ------------------------------------------------------------------------------
# 5. Web Push Notifications (Optional — both keys required if enabled)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@__YOUR_DOMAIN__

# ------------------------------------------------------------------------------
# 6. Local Vite Development Proxy Only (Do NOT set in VPS runtime env)
# ------------------------------------------------------------------------------
SELF_HOSTED_API_TARGET=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 7. Controlled Data Migration CLI (`npm run db:data:*` — Operator Shell Only)
# ------------------------------------------------------------------------------
# Do NOT place source/target migration URLs inside /etc/swiftsweeps/api.env.
MIGRATION_SOURCE_ENV=staging
MIGRATION_SOURCE_DATABASE_URL=
MIGRATION_SOURCE_SSL_MODE=require
MIGRATION_TARGET_ENV=staging
MIGRATION_TARGET_DATABASE_URL=
MIGRATION_TARGET_SSL_MODE=disable
MIGRATION_ALLOW_PRODUCTION_SOURCE=false
MIGRATION_ALLOW_PRODUCTION_TARGET=false
MIGRATION_ARTIFACT_DIR=./tmp/data-migration
MIGRATION_BATCH_SIZE=500
MIGRATION_CHECKPOINT_PATH=
MIGRATION_MAX_RETRIES=3
MIGRATION_REPORT_PATH=

# ------------------------------------------------------------------------------
# 8. Legacy Pre-Retirement Placeholders (Keep Empty on Self-Hosted VPS)
# ------------------------------------------------------------------------------
# Retained solely while legacy Vercel/Supabase scripts exist prior to final retirement.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_JWKS_URL=