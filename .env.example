SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
VITE_FIREBASE_5OAUTH_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_JWKS_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Persistent Node.js API foundation (place real values in ignored .env / systemd EnvironmentFile)
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Optional overrides when hosting sets a global frontend/proxy PORT (e.g. PORT=8080)
API_PORT=4000
SELF_HOSTED_API_TARGET=http://127.0.0.1:4000
# Primary origin (or comma-separated origins). In production, set exact https:// domain(s)
APP_ORIGIN=http://localhost:3000
# Optional comma-separated extra allowed origins (e.g. https://www.yourdomain.com)
TRUSTED_ORIGINS=
TRUST_PROXY=loopback
# Format: postgres://<user>:<password>@127.0.0.1:5432/<database>
DATABASE_URL=
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_SSL_MODE=disable
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Self-hosted authentication (Better Auth + PostgreSQL)
# Generate a strong secret in production: openssl rand -base64 32
AUTH_SECRET=
AUTH_COOKIE_PREFIX=swiftsweeps_auth
AUTH_SESSION_EXPIRES_IN_SEC=604800
AUTH_SESSION_UPDATE_AGE_SEC=86400
AUTH_SESSION_FRESH_AGE_SEC=900
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=30

# Email delivery adapter for verification OTP & password reset ('disabled', 'brevo', or 'smtp')
# - Use 'brevo' with BREVO_API_KEY (xkeysib-...) for Brevo HTTPS API (no extra config needed)
# - Use 'smtp' with SMTP_HOST=smtp-relay.brevo.com for Brevo SMTP credentials (xsmtpsib-...)
EMAIL_PROVIDER=disabled
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SwiftSweeps